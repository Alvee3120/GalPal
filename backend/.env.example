# Copy to .env and adjust. Real environment variables override this file.

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Which settings module manage.py/gunicorn use: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Local:  postgres://galpal:galpal@localhost:5432/galpal
# Shared cloud Postgres (e.g. Neon): use the DIRECT (non-pooled) connection string, keep sslmode:
#   postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgres://galpal:galpal@localhost:5432/galpal
# `neon link` also writes DATABASE_URL_UNPOOLED. When set, it wins over DATABASE_URL (Django needs
# the direct, non-pooled connection).
# DATABASE_URL_UNPOOLED=
DB_CONN_MAX_AGE=60
# `pytest` ALWAYS uses this local database, never DATABASE_URL, so the test suite can't touch a
# shared cloud database. Only set it if your local Postgres differs from the default.
# TEST_DATABASE_URL=postgres://galpal:galpal@localhost:5432/galpal

# --- CORS / CSRF (the Next.js storefront and admin panel origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Cache (Redis) ---
# Leave empty for a per-process in-memory cache (fine for dev). REQUIRED in production with
# several gunicorn workers, otherwise a settings change is only seen by the worker that handled it.
REDIS_URL=
# Seconds the site-settings row stays cached (default: 3600 with Redis, 30 without)
# SITE_SETTINGS_CACHE_TTL=

# --- Auth (JWT) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Forgot-password one-time codes
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email / SMS ---
# dev.py defaults: emails and SMS are printed to the console. In production set real providers.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=GalPal <no-reply@yourdomain.com>
# Default in production drops SMS (never logs them) until you write/point to a provider backend:
# SMS_BACKEND=apps.core.messaging.NullSMSBackend

# --- Uploads ---
IMAGE_MAX_UPLOAD_SIZE=5242880

# --- Media storage: local disk (default) or Cloudflare R2 / any S3-compatible bucket ---
# Local disk is used unless USE_S3=True. `pytest` ignores all of this and always uses temp files.
USE_S3=False
# Cloudflare R2 (see README "Shared cloud setup"):
# (Put comments on their own line, never after a value.)
# The names say "AWS" only because R2 speaks the S3 protocol; nothing here talks to Amazon.
# R2 API token: Access Key ID
# AWS_ACCESS_KEY_ID=
# R2 API token: Secret Access Key
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=galpal-media
# The endpoint has NO bucket name at the end.
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional: defaults to "auto" when an endpoint is set.
# AWS_S3_REGION_NAME=auto
# The PUBLIC host of the bucket, host only. Required for R2.
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev

# --- Production only ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
