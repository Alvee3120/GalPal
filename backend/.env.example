# Copy to .env and adjust. Real environment variables override this file.

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Which settings module manage.py/gunicorn use: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://galpal:galpal@localhost:5432/galpal
DB_CONN_MAX_AGE=60

# --- CORS / CSRF (the Next.js storefront and admin panel origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Auth (JWT) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Forgot-password one-time codes
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email / SMS ---
# dev.py defaults: emails and SMS are printed to the console. In production set real providers.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=GalPal <no-reply@yourdomain.com>
# Default in production drops SMS (never logs them) until you write/point to a provider backend:
# SMS_BACKEND=apps.core.messaging.NullSMSBackend

# --- Uploads ---
IMAGE_MAX_UPLOAD_SIZE=5242880

# --- Optional: S3-compatible media storage (local filesystem is used when False) ---
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=

# --- Production only ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
